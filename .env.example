# Public build-time configuration. Never put a secret API key in a VITE_ variable.
VITE_BOOKING_URL=
VITE_OURTALENTO_URL=
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
# Empty disables analytics. Set plausible (ID = domain) or gtag (ID = measurement ID).
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_ID=
# EmailJS browser public identifiers; configure recipient in the EmailJS admin template.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_ADMIN_TEMPLATE_ID=
VITE_EMAILJS_USER_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
